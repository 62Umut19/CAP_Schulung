     "@Common.IsUpperCase": true,
     "@Common.Label": "Sales Organization",
     "@Common.Heading": "SOrg.",
     "@Common.DocumentationRef": "urn:sap-com:documentation:key?=type=DE&id=VKORG"
    },
    "ProductDistributionChnl": {
     "key": true,
     "type": "cds.String",
     "length": 2,
     "notNull": true,
     "@Core.Computed": true,
     "@Common.IsUpperCase": true,
     "@Common.Label": "Distribution Channel",
     "@Common.Heading": "DChl",
     "@Common.DocumentationRef": "urn:sap-com:documentation:key?=type=DE&id=VTWEG"
    },
    "ProductTaxClassification": {
     "type": "cds.String",
     "length": 1,
     "notNull": true
    },
    "SAP__Messages": {
     "items": {
      "type": "CE_PRODUCT_0002.SAP__Message",
      "notNull": true
     }
    },
    "_Product": {
     "type": "cds.Association",
     "@cds.ambiguous": "missing on condition?",
     "target": "CE_PRODUCT_0002.Product",
     "cardinality": {
      "max": 1
     },
     "on": [
      {
       "ref": [
        "_Product",
