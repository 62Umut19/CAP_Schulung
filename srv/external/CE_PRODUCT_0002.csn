     "@Common.QuickInfo": "Tax Condition Type (Sales Tax, Value-Added Tax,...)",
     "@Common.DocumentationRef": "urn:sap-com:documentation:key?=type=DE&id=TATYP"
    },
    "ProductSalesOrg": {
     "key": true,
